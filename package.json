{
  "name": "devworklog-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "AI-agent-friendly developer worklog system",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fawazbayureksa/DevWorklog.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "format": "prettier --write \"**/*.{ts,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
